# The API, INCLUDING /api (e.g. https://smrithi-api.onrender.com/api). Baked in at build time; a production build refuses to run without it.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api
# The public website, for the "View on site" links (e.g. https://smrithi.example). Required for production builds too.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
